---
import type { Dinner } from '../dinners';

interface Props {
  dinner: Dinner;
  backHref: string;
}

const { dinner, backHref } = Astro.props;
const background = encodeURI(dinner.background ?? '/menu background.jpg');
---

<main class="menu" style={`--menu-bg: url('${background}')`}>
  <div class="menu-inner">
    <section class="paper">
      <img class="paper-logo" src="/logo.svg" alt="Supper Club" width="595" height="842" decoding="async" />
      <p class="paper-kicker">menu</p>
      <h1 class="theme">{dinner.theme}</h1>
      {
        dinner.courses.map((course) => (
          <article class="course">
            {course.name ? (
              <>
                <h2 class="course-name">{course.name}</h2>
                <p class="course-detail">{course.detail}</p>
              </>
            ) : (
              <span class="course-mark" aria-label={`Course ${course.num}, to be revealed`}>?</span>
            )}
          </article>
        ))
      }
    </section>

    <slot />

    <a class="menu-back" href={backHref}>&larr; Back</a>
  </div>
</main>

<style>
  .menu {
    height: 100dvh;
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    padding: 1.5rem 1rem 1rem;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    background:
      var(--menu-bg) center/cover no-repeat,
      #000;
  }

  .menu-inner {
    position: relative;
    z-index: 2;
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }

  /* Solid white sheet with a thin inset frame, after the printed menu */
  .paper {
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: 380px;
    background: #fff;
    color: #111;
    outline: 1px solid #111;
    outline-offset: -10px;
    box-shadow: 0 18px 48px -18px rgba(0, 0, 0, 0.75);
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    overflow-y: auto;
    animation: paper-in 900ms cubic-bezier(0.25, 0.6, 0.2, 1) both;
  }

  @keyframes paper-in {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .paper {
      animation: none;
    }
  }

  /* logo.svg has generous padding baked in, so crop it with a negative margin */
  .paper-logo {
    flex: 0 0 auto;
    height: clamp(120px, 17vh, 170px);
    width: auto;
    margin: -1.25rem 0 -1.4rem;
  }

  .paper-kicker {
    font-family: 'Times New Roman', Times, serif;
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    margin-top: 0.35rem;
  }

  .theme {
    font-family: 'Times New Roman', Times, serif;
    font-weight: 700;
    font-size: clamp(1.45rem, 6vw, 1.85rem);
    letter-spacing: 0.05em;
    text-transform: lowercase;
    line-height: 1.1;
    margin-bottom: 0.4rem;
  }

  .course {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.45rem 0;
  }

  .course-name {
    font-family: 'Times New Roman', Times, serif;
    font-size: clamp(0.92rem, 3.6vw, 1.02rem);
    font-weight: 400;
    letter-spacing: 0.24em;
    text-indent: 0.24em;
    text-transform: lowercase;
    line-height: 1.2;
  }

  .course-detail {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-size: clamp(0.88rem, 3.4vw, 0.98rem);
    font-weight: 400;
    letter-spacing: 0.03em;
    color: #222;
    line-height: 1.35;
    max-width: 30ch;
  }

  .course-mark {
    font-family: 'Times New Roman', Times, serif;
    font-size: 1.05rem;
    letter-spacing: 0.24em;
    color: #111;
    opacity: 0.6;
  }

  .menu-back {
    font-family: 'Inter', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: rgba(245, 239, 230, 0.92);
    background: rgba(8, 6, 4, 0.78);
    padding: 0.45rem 1rem;
    border-bottom: 1px solid transparent;
    transition:
      color 260ms ease,
      border-color 260ms ease;
  }

  .menu-back:hover,
  .menu-back:focus-visible {
    color: #fff;
    border-color: rgba(245, 239, 230, 0.45);
    outline: none;
  }
</style>
