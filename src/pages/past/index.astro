---
import Layout from '../../layouts/Layout.astro';
import { pastDinners } from '../../dinners';
---

<Layout title="Supper Club — Past Dinners" tone="dark">
  <main class="past">
    <div class="past-inner">
      <h1 class="past-title">Past Dinners</h1>
      <nav class="past-list">
        {
          pastDinners.map((dinner) => (
            <a class="past-btn" href={`/past/${dinner.slug}`}>
              {dinner.theme}
            </a>
          ))
        }
      </nav>
      <a class="past-back" href="/home">&larr; Back</a>
    </div>
  </main>
</Layout>

<style>
  .past {
    height: 100dvh;
    min-height: 100vh;
    overflow: hidden;
    padding: 2rem 1rem 1.25rem;
    display: grid;
    place-items: center;
    background:
      url('/menu%20background.jpg') center/cover no-repeat,
      #000;
  }

  .past-inner {
    width: 100%;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    animation: past-in 900ms cubic-bezier(0.25, 0.6, 0.2, 1) both;
  }

  @keyframes past-in {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .past-inner {
      animation: none;
    }
  }

  .past-title {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-weight: 300;
    font-size: clamp(1.1rem, 3.8vw, 1.35rem);
    letter-spacing: 0.05em;
    text-indent: 0.05em;
    text-transform: uppercase;
    color: #f5efe6;
    text-align: center;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgba(245, 239, 230, 0.14);
    width: 100%;
  }

  .past-list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .past-btn {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-size: 0.82rem;
    font-weight: 300;
    letter-spacing: 0.62em;
    text-indent: 0.62em;
    text-transform: uppercase;
    text-align: center;
    padding: 0.85rem 1.5rem;
    border: 1px solid rgba(245, 239, 230, 0.38);
    background: rgba(10, 8, 6, 0.42);
    color: var(--ink);
    transition:
      border-color 320ms ease,
      color 320ms ease;
  }

  .past-btn:hover,
  .past-btn:focus-visible {
    border-color: rgba(245, 239, 230, 0.85);
    color: #ffffff;
    outline: none;
  }

  .past-back {
    font-family: 'Inter', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: rgba(245, 239, 230, 0.7);
    padding: 0.35rem 0.9rem;
    border-bottom: 1px solid transparent;
    transition:
      color 260ms ease,
      border-color 260ms ease;
  }

  .past-back:hover,
  .past-back:focus-visible {
    color: #fff;
    border-color: rgba(245, 239, 230, 0.45);
    outline: none;
  }
</style>
