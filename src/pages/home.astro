---
import Layout from '../layouts/Layout.astro';
import Dust from '../components/Dust.astro';
import { registerUrl } from '../site';

const links = [
  { label: 'Register', href: registerUrl, external: true },
  { label: 'Menu', href: '/menu' },
];

// Quieter links for people who want to learn more, kept apart from the current dinner.
const moreLinks = [
  { label: 'Past Dinners', href: '/past' },
  { label: 'About Us', href: '/about' },
];
---

<Layout title="Supper Club — Grimm's Fairy Tales">
  <main class="home">
    <Dust count={18} />
    <div class="cover">
      <!-- The cover art already shows the title, so keep it for screen readers only -->
      <h1 class="sr-only">Grimm's Fairy Tales</h1>
      <div class="actions">
        {
          links.map((link) => (
            <div class="btn-wrap">
              {link.external ? (
                <a class="btn" href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ) : (
                <a class="btn" href={link.href}>
                  {link.label}
                </a>
              )}
            </div>
          ))
        }
        <nav class="more" aria-label="Learn more">
          {
            moreLinks.map((link, i) => (
              <>
                {i > 0 && <span class="more-sep" aria-hidden="true">&middot;</span>}
                <a class="more-link" href={link.href}>
                  {link.label}
                </a>
              </>
            ))
          }
        </nav>
      </div>
      <img class="mark" src="/white%20logo.svg" alt="Supper Club" width="595" height="842" decoding="async" />
    </div>
  </main>
</Layout>

<style>
  .home {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    text-align: center;
    background: #1a0706;
    isolation: isolate;
  }

  /* Blurred copy of the cover fills the sides on screens wider than the art */
  .home::before {
    content: '';
    position: absolute;
    inset: -40px;
    background: url('/grimm-cover.jpg') center/cover no-repeat;
    filter: blur(28px) brightness(0.45);
    z-index: 0;
  }

  /* Full-height stage with the cover's proportions; on phones its edges crop */
  .cover {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    height: 100%;
    aspect-ratio: 998 / 1576;
    background: url('/grimm-cover.jpg') center/100% 100% no-repeat;
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.6);
    z-index: 1;
  }

  /* Positions are fractions of the cover: its title sits at roughly 17–30%.
     logo.svg's artwork fills only its middle 28–72%, hence the large box. */
  .mark {
    position: absolute;
    left: 50%;
    top: 55%;
    height: 40%;
    width: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.7));
  }

  .cover > .actions {
    position: absolute;
    left: 50%;
    top: 34%;
    transform: translateX(-50%);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.85rem;
    width: min(320px, 72vw);
  }

  .btn {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-size: 0.82rem;
    font-weight: 300;
    letter-spacing: 0.62em;
    text-transform: uppercase;
    padding: 1rem 2rem;
    border: 1px solid rgba(232, 200, 140, 0.55);
    background: rgba(14, 4, 4, 0.68);
    color: var(--ink);
    text-align: center;
    transition:
      border-color 320ms ease,
      color 320ms ease,
      background 320ms ease,
      letter-spacing 320ms ease;
  }

  .btn:hover,
  .btn:focus-visible {
    border-color: rgba(245, 239, 230, 0.85);
    color: #ffffff;
    letter-spacing: 0.72em;
    outline: none;
  }

  @media (max-width: 480px) {
    .btn {
      padding: 0.9rem 1.4rem;
      letter-spacing: 0.48em;
    }
    .btn:hover,
    .btn:focus-visible {
      letter-spacing: 0.56em;
    }
  }

  .btn-wrap {
    position: relative;
    display: block;
  }

  .btn-wrap .btn {
    display: block;
    width: 100%;
  }

  .more {
    align-self: center;
    background: rgba(14, 4, 4, 0.68);
    padding: 0.2rem 0.9rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  .more-link {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.02rem;
    letter-spacing: 0.06em;
    color: rgba(245, 239, 230, 0.72);
    padding: 0.3rem 0;
    border-bottom: 1px solid transparent;
    transition:
      color 260ms ease,
      border-color 260ms ease;
  }

  .more-link:hover,
  .more-link:focus-visible {
    color: #fff;
    border-color: rgba(245, 239, 230, 0.5);
    outline: none;
  }

  .more-sep {
    color: rgba(232, 200, 140, 0.7);
    font-size: 0.9rem;
  }
</style>
