---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Dust from '../components/Dust.astro';
import { registerUrl } from '../site';

const links = [
  { label: 'Register', href: registerUrl, external: true },
  { label: 'Menu', href: '/menu' },
];

// Quieter links for people who want to learn more, kept apart from the current dinner.
const moreLinks = [
  { label: 'Past Dinners', href: '/past' },
  { label: 'About Us', href: '/about' },
];
---

<Layout title="Supper Club — Grimm's Fairy Tales">
  <main class="home">
    <Dust count={18} />
    <div class="stack">
      <div class="mark">
        <Logo variant="mark" white />
      </div>
      <h1 class="theme">Grimm's Fairy Tales</h1>
      <div class="actions">
        {
          links.map((link) => (
            <div class="btn-wrap">
              {link.external ? (
                <a class="btn" href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ) : (
                <a class="btn" href={link.href}>
                  {link.label}
                </a>
              )}
            </div>
          ))
        }
        <nav class="more" aria-label="Learn more">
          {
            moreLinks.map((link, i) => (
              <>
                {i > 0 && <span class="more-sep" aria-hidden="true">&middot;</span>}
                <a class="more-link" href={link.href}>
                  {link.label}
                </a>
              </>
            ))
          }
        </nav>
      </div>
    </div>
  </main>
</Layout>

<style>
  .home {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto minmax(0, 1fr);
    justify-items: center;
    padding: 1rem;
    text-align: center;
    background:
      linear-gradient(180deg, rgba(11, 20, 15, 0.22) 0%, rgba(5, 10, 7, 0.52) 100%),
      url('/flowers%20background.jfif') center/cover no-repeat,
      #000;
    isolation: isolate;
  }

  .stack {
    display: contents;
  }

  .stack > .mark,
  .stack > .theme,
  .stack > .actions {
    position: relative;
    z-index: 2;
  }

  .stack > .mark {
    align-self: end;
  }

  .stack > .theme {
    align-self: center;
  }

  .stack > .actions {
    align-self: start;
    margin-top: 1rem;
  }

  .mark {
    display: flex;
    justify-content: center;
    margin-bottom: calc(3.75rem - 0.44 * clamp(340px, 62vmin, 720px));
  }

  .theme {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-weight: 300;
    font-style: normal;
    font-size: clamp(1.4rem, 7vw, 5rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.05;
    color: #f5efe6;
    margin: 0;
    /* compensate for trailing letter-spacing so the word stays optically centered */
    text-indent: 0.18em;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.85rem;
    width: min(320px, 72vw);
    margin-top: 0.75rem;
  }

  .btn {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-size: 0.82rem;
    font-weight: 300;
    letter-spacing: 0.62em;
    text-transform: uppercase;
    padding: 1rem 2rem;
    border: 1px solid rgba(245, 239, 230, 0.38);
    color: var(--ink);
    text-align: center;
    transition:
      border-color 320ms ease,
      color 320ms ease,
      background 320ms ease,
      letter-spacing 320ms ease;
  }

  .btn:hover,
  .btn:focus-visible {
    border-color: rgba(245, 239, 230, 0.85);
    color: #ffffff;
    letter-spacing: 0.72em;
    outline: none;
  }

  @media (max-width: 480px) {
    .btn {
      padding: 0.9rem 1.4rem;
      letter-spacing: 0.48em;
    }
    .btn:hover,
    .btn:focus-visible {
      letter-spacing: 0.56em;
    }
  }

  .btn-wrap {
    position: relative;
    display: block;
  }

  .btn-wrap .btn {
    display: block;
    width: 100%;
  }

  .more {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  .more-link {
    font-family: 'Inter', sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    text-indent: 0.32em;
    text-transform: uppercase;
    color: rgba(245, 239, 230, 0.72);
    padding: 0.3rem 0;
    border-bottom: 1px solid transparent;
    transition:
      color 260ms ease,
      border-color 260ms ease;
  }

  .more-link:hover,
  .more-link:focus-visible {
    color: #fff;
    border-color: rgba(245, 239, 230, 0.5);
    outline: none;
  }

  .more-sep {
    color: rgba(245, 239, 230, 0.5);
    font-size: 0.7rem;
  }
</style>
